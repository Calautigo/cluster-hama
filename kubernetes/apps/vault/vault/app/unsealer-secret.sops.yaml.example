---
# Rename to unsealer-secret.sops.yaml after filling in keys from `vault operator init`
# Then encrypt: sops -e -i kubernetes/apps/vault/vault/app/unsealer-secret.sops.yaml
# Then add unsealer-secret.sops.yaml and unsealer.yaml to kustomization.yaml
apiVersion: v1
kind: Secret
metadata:
  name: vault-unseal-keys
  namespace: vault
stringData:
  VAULT_UNSEAL_KEY_1: "REPLACE_WITH_UNSEAL_KEY_1"
  VAULT_UNSEAL_KEY_2: "REPLACE_WITH_UNSEAL_KEY_2"
  VAULT_UNSEAL_KEY_3: "REPLACE_WITH_UNSEAL_KEY_3"
