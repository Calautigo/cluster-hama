{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "local>dominik/cluster-hama//.renovate/groups.json5",
    "local>dominik/cluster-hama//.renovate/versioning.json5",
    "local>dominik/cluster-hama//.renovate/autoMerge.json5",
    "local>dominik/cluster-hama//.renovate/grafanaDashboards.json5",
  ],
  "flux": {
    "fileMatch": ["^kubernetes/.+\\.ya?ml$"],
  },
  "helm-values": {
    "fileMatch": ["^kubernetes/.+\\.ya?ml$"],
  },
  "kubernetes": {
    "fileMatch": ["^kubernetes/.+\\.ya?ml$"],
  }
}