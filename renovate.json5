{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "github>calautigo/cluster-hama//.renovate/groups.json5",
    "github>calautigo/cluster-hama//.renovate/versioning.json5",
    "github>calautigo/cluster-hama//.renovate/autoMerge.json5",
    "github>calautigo/cluster-hama//.renovate/grafanaDashboards.json5",
  ],
  flux: {
    managerFilePatterns: ["/^clusters/.+\\.ya?ml$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/^clusters/.+\\.ya?ml$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/^clusters/.+\\.ya?ml$/"],
  },
}
