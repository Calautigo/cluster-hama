{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>calautigo/renovate-config",
    "github>calautigo/cluster-hama//.renovate/overrides.json5",
    "github>calautigo/cluster-hama//.renovate/groups.json5",
    "github>calautigo/cluster-hama//.renovate/autoMerge.json5",
    "github>calautigo/cluster-hama//.renovate/customManagers.json5",
    "github>calautigo/cluster-hama//.renovate/grafanaDashboards.json5",
  ],
  flux: {
    managerFilePatterns: ["/^clusters/.+\\.yaml(?:\\.j2)?$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/^clusters/.+\\.yaml(?:\\.j2)?$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/^clusters/.+\\.yaml(?:\\.j2)?$/"],
  }
}