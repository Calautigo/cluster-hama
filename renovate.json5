{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    ":automergeBranch",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":separatePatchReleases",
    ":skipStatusChecks",
    ":timezone(Europe/Vienna)",
    "./.renovate/groups.json5",
    "./.renovate/versioning.json5",
    "./.renovate/autoMerge.json5",
    "./.renovate/grafanaDashboard.json5",
  ],
  "ignorePaths": ["**/*.sops.*", "**/resources/**"],
  "flux": {
    "fileMatch": [
      "(^|/)kubernetes/.+\\.ya?ml$"
    ]
  },
  "helm-values": {
    "fileMatch": [
      "(^|/)kubernetes/.+\\.ya?ml$"
    ]
  },
  "kubernetes": {
    "fileMatch": [
      "(^|/)kubernetes/.+\\.ya?ml$"
    ]
  }
}