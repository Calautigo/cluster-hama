{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    ":automergeBranch",
    ":automergeMinor",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":semanticCommits",
    ":timezone(Europe/Vienna)",
    // local> resolves against the configured platform/endpoint, so these stay
    // correct if the repo moves hosts again.
    "local>Calautigo/cluster-hama//.renovate/overrides.json5",
    "local>Calautigo/cluster-hama//.renovate/groups.json5",
    "local>Calautigo/cluster-hama//.renovate/autoMerge.json5",
    "local>Calautigo/cluster-hama//.renovate/customManagers.json5",
    "local>Calautigo/cluster-hama//.renovate/grafanaDashboards.json5",
  ],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  suppressNotifications: ["prEditedNotification", "prIgnoreNotification"],
  ignorePaths: ["**/*.sops.*"],
  flux: {
    managerFilePatterns: ["/^(kubernetes|talos)\\/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/^(kubernetes|talos)\\/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/^(kubernetes|talos)\\/.+\\.ya?ml(?:\\.j2)?$/"],
  },
}
