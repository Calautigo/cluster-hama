{
  "files.associations": {
    "clusters/**/*.sops.yaml": "yaml",
    "clusters/**/*.sops.yml": "yaml"
  },
  "prettier.configPath": ".prettierrc.yaml",
  "prettier.ignorePath": ".prettierignore",
  "yaml.schemas": {
    "kubernetes": ["clusters/*.yml", "clusters/*.yaml"]
  },
  "sops.defaults.ageKeyFile": "~/.config/sops/age/dominik-age.key",
  "sops.creationEnabled": true,
}