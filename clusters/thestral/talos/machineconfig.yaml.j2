---
# yaml-language-server: $schema=https://raw.githubusercontent.com/siderolabs/talos/refs/heads/release-1.10/website/content/v1.10/schemas/config.schema.json
version: v1alpha1
machine:
  ca:
    crt: sops://talos/.certs.os.crt
    {% if ENV.IS_CONTROLPLANE %}
    key: sops://talos/.certs.os.key
    {% endif %}
  features:
    apidCheckExtKeyUsage: true
    diskQuotaSupport: true
    hostDNS:
      enabled: true
      forwardKubeDNSToHost: true
      resolveMemberNames: true
    kubePrism:
      enabled: true
      port: 7445
    {% if ENV.IS_CONTROLPLANE %}
    kubernetesTalosAPIAccess:
      enabled: true
      allowedRoles:
        - os:admin
      allowedKubernetesNamespaces:
        - actions-runner-system
        - system-upgrade
    {% endif %}
    rbac: true
    stableHostname: true
  files:
    - op: create
      path: /etc/cri/conf.d/20-customization.part
      content: |-
        [plugins]
          [plugins."io.containerd.grpc.v1.cri"]
            enable_unprivileged_ports = true
            enable_unprivileged_icmp = true
        [plugins."io.containerd.cri.v1.images"]
          discard_unpacked_layers = false
        [plugins."io.containerd.cri.v1.runtime"]
          cdi_spec_dirs = ["/var/cdi/static", "/var/cdi/dynamic"]
          device_ownership_from_security_context = true
    - op: overwrite
      path: /etc/nfsmount.conf
      permissions: 0o644
      content: |
        [ NFSMount_Global_Options ]
        nfsvers=4.2
        hard=True
        noatime=True
        nconnect=16
  kernel:
    modules:
      - name: nbd
  kubelet:
    defaultRuntimeSeccompProfileEnabled: true
    disableManifestsDirectory: true
    extraConfig:
      maxPods: 150
      serializeImagePulls: false
    image: ghcr.io/siderolabs/kubelet:v1.35.2
    nodeIP:
      validSubnets:
        - 10.100.10.0/24
  network:
    interfaces:
      - interface: ens18
        mtu: 1500
        routes:
          - network: 0.0.0.0/0
            gateway: 10.100.10.1
            metric: 10
        {% if ENV.IS_CONTROLPLANE %}
        vip:
          ip: 10.100.10.70
        {% endif %}
      - interface: ens19
        mtu: 9000
        routes:
          - network: 10.44.0.0/16
            metric: 500
    nameservers:
      - 10.10.10.32
    disableSearchDomain: true
  sysctls:
    fs.inotify.max_user_instances: "8192"
    fs.inotify.max_user_watches: "1048576"
    net.core.rmem_max: "67108864"
    net.core.wmem_max: "67108864"
    net.ipv4.neigh.default.gc_thresh1: "4096"
    net.ipv4.neigh.default.gc_thresh2: "8192"
    net.ipv4.neigh.default.gc_thresh3: "16384"
    net.ipv4.tcp_fastopen: "3"
    user.max_user_namespaces: "11255"
  time:
    disabled: false
    servers:
      - 10.100.10.1
  token: sops://talos/.trustdinfo.token
  udev:
    rules:
      - ACTION=="add", SUBSYSTEM=="thunderbolt", ATTR{power/control}="on"
cluster:
  {% if ENV.IS_CONTROLPLANE %}
  aggregatorCA:
    crt: sops://talos/.certs.k8saggregator.crt
    key: sops://talos/.certs.k8saggregator.key
  allowSchedulingOnControlPlanes: false
  apiServer:
    image: registry.k8s.io/kube-apiserver:v1.35.2
    extraArgs:
      enable-aggregator-routing: "true"
      feature-gates: MutatingAdmissionPolicy=true
      runtime-config: admissionregistration.k8s.io/v1beta1=true
    certSANs:
      - 127.0.0.1 # KubePrism
      - 10.100.10.70
      - api.thestral.infra.gryffindor.schwarz47.at
    disablePodSecurityPolicy: true
  controllerManager:
    image: registry.k8s.io/kube-controller-manager:v1.35.2
    extraArgs:
      bind-address: 0.0.0.0
  coreDNS:
    disabled: true
  etcd:
    advertisedSubnets:
      - 10.100.10.0/24
    ca:
      crt: sops://talos/.certs.etcd.crt
      key: sops://talos/.certs.etcd.key
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
  proxy:
    disabled: true
    image: registry.k8s.io/kube-proxy:v1.35.2
  scheduler:
    config:
      apiVersion: kubescheduler.config.k8s.io/v1
      kind: KubeSchedulerConfiguration
      profiles:
        - pluginConfig:
            - args:
                defaultConstraints:
                  - maxSkew: 1
                    topologyKey: kubernetes.io/hostname
                    whenUnsatisfiable: ScheduleAnyway
                defaultingType: List
              name: PodTopologySpread
          plugins:
            score:
              disabled:
                - name: ImageLocality
          schedulerName: default-scheduler
    extraArgs:
      bind-address: 0.0.0.0
    image: registry.k8s.io/kube-scheduler:v1.35.2
  serviceAccount:
    key: sops://talos/.certs.k8sserviceaccount.key
  {% endif %}
  ca:
    crt: sops://talos/.certs.k8s.crt
    {% if ENV.IS_CONTROLPLANE %}
    key: sops://talos/.certs.k8s.key
    {% endif %}
  controlPlane:
    endpoint: https://10.100.10.70:6443
  clusterName: thestral
  discovery:
    enabled: true
    registries:
      kubernetes: { disabled: true }
      service: { disabled: false }
  id: sops://talos/.cluster.id
  secret: sops://talos/.cluster.secret
  network:
    cni:
      name: none
    dnsDomain: cluster.local
    podSubnets:
      - 11.244.0.0/16
    serviceSubnets:
      - 11.96.0.0/12
  token: sops://talos/.secrets.bootstraptoken
  secretboxEncryptionSecret: sops://talos/.secrets.secretboxEncryptionSecret
{% if not ENV.IS_CONTROLPLANE %}
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: local-hostpath
provisioning:
  diskSelector:
    match: disk.transport == 'virtio' && disk.size < 100u * GiB
  maxSize: 60GiB
{% endif %}